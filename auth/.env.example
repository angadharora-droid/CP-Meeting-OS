# Central sign-on service
PORT=4100

# MongoDB (can be the same cluster as Meeting OS, different database name)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/cpg_auth?retryWrites=true&w=majority

# Secret used to sign hand-off tokens. Long random string. Never share with browsers.
AUTH_TOKEN_SECRET=change-me-to-a-long-random-string

# Secret that app backends send in the X-SSO-Secret header when the auth service
# asks them for their user list (see SSO_USERS_URL_* below).
SSO_SHARED_SECRET=change-me-to-another-long-random-string

# Cookie settings.
# COOKIE_DOMAIN must be the parent domain so every app subdomain receives it.
# Leave COOKIE_DOMAIN empty for local development.
COOKIE_NAME=cpg_sso
COOKIE_DOMAIN=.centrepointgroup.in
# true in production (HTTPS). Defaults to true when NODE_ENV=production.
COOKIE_SECURE=true
SESSION_DAYS=7

# Browser origins allowed to call this service with credentials (comma separated).
AUTH_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://centrepointgroup.in,https://www.centrepointgroup.in,https://meetingos.centrepointgroup.in

# First admin, created on start-up only when no admin exists yet.
AUTH_ADMIN_ID=admin
AUTH_ADMIN_NAME=Angadh Arora
AUTH_ADMIN_SECRET=change-me
# pin or password
AUTH_ADMIN_SECRET_TYPE=password

# Per-app user directories used by the admin matching screen.
# Key is the app key upper-cased with dashes replaced by underscores.
# The auth service calls this URL with header X-SSO-Secret: <SSO_SHARED_SECRET>
# and expects a JSON array of { id, name, email, role, secret }.
SSO_USERS_URL_MEETING_OS=http://localhost:4000/api/sso/users

# Optional keep-alive ping for free hosting tiers (same as the Meeting OS backend)
KEEP_ALIVE_ENABLED=false
KEEP_ALIVE_URL=https://auth.centrepointgroup.in
